GMAIL_USER=
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REFRESH_TOKEN=
PORT=3001

# Shared secret the frontend must send as the x-notify-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
NOTIFY_API_KEY=

# Comma-separated list of origins allowed to call this server.
ALLOWED_ORIGINS=http://localhost:5173

# Used to verify the admin's Cognito ID token for service-update emails.
# Copy these from amplify_outputs.json (auth.user_pool_id / user_pool_client_id / aws_region).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
COGNITO_REGION=
