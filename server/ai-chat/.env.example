# OpenRouter (https://openrouter.ai/keys)
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o
SITE_URL=http://localhost:5173
SITE_NAME=SacraDigit

PORT=3002

# Shared secret the frontend must send as the x-chat-key header.
# Generate one with: node -e "console.log(require('crypto').randomBytes(24).toString('hex'))"
CHAT_API_KEY=

# Comma-separated list of origins allowed to call this server.
ALLOWED_ORIGINS=http://localhost:5173

# Used to verify the signed-in parishioner's Cognito ID token.
# Copy these from amplify_outputs.json (auth.user_pool_id / user_pool_client_id).
COGNITO_USER_POOL_ID=
COGNITO_CLIENT_ID=
