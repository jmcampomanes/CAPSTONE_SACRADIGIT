# Optional. Copy to .env only if you need to change something.

# Ollama (the local AI runtime) and the model it should use.
OLLAMA_URL=http://127.0.0.1:11434
# qwen2.5vl:3b  = fits a laptop with ~16 GB RAM, runs on CPU (slow but works)
# qwen2.5vl:7b  = more accurate, wants a GPU with ~8 GB memory (or lots of patience on CPU)
OLLAMA_MODEL=qwen2.5vl:3b

# PaddleOCR models: "mobile" (faster, default) or "server" (more accurate, ~4x slower on CPU).
OCR_PROFILE=mobile

# Longest side (pixels) of the picture shown to the AI. Smaller = faster.
VLM_MAX_SIDE=1280

# Pages the browser may call this service from (comma-separated).
# Add your deployed site's address if the admin portal is hosted online.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:4173

# Optional shared secret. If set, put the same value in VITE_OCR_API_KEY.
OCR_API_KEY=
